# Przykładowy reverse proxy nginx z HTTPS (certbot) i hasłem (Basic Auth).
# htpasswd: sudo apt install apache2-utils && sudo htpasswd -c /etc/nginx/.aurum_htpasswd jacob
server {
    listen 80;
    server_name aurum.twojadomena.pl;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name aurum.twojadomena.pl;

    ssl_certificate     /etc/letsencrypt/live/aurum.twojadomena.pl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aurum.twojadomena.pl/privkey.pem;

    auth_basic           "AURUM";
    auth_basic_user_file /etc/nginx/.aurum_htpasswd;

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
