# ─────────────────────────────────────────────────────────────
# AURUM // Gold Macro & Geo Intelligence — konfiguracja
# Skopiuj do .env. Aplikacja pokazuje wyłącznie prawdziwe dane — źródło bez klucza lub chwilowo niedostępne ma oznaczenie „brak danych”.
# ─────────────────────────────────────────────────────────────

# ── FRED (wymagany do panelu TŁO MAKRO i paska MACRO) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
FRED_TTL_SEC=21600

# ── Twelve Data (opcjonalny) — SEZONOWOŚĆ i REAKCJA ZŁOTA NA ZDARZENIA: 2 zapytania na dobę
TWELVEDATA_API_KEY=

# ── GPR (Caldara–Iacoviello) i IMF (rezerwy złota) — bez klucza. Nadpisanie adresów tylko przy zmianach po stronie źródeł:
# GPR_DAILY_URL=https://www.matteoiacoviello.com/gpr_files/data_gpr_daily_recent.xls
# IMF_API_BASE=https://api.imf.org/external/sdmx/2.1

# ── Kalendarz (ForexFactory JSON, bez klucza). Publikacje USD obsługuje GOLD DESK — domyślnie pomijane.
CALENDAR_INCLUDE_USD=false
# FF_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# FF_CALENDAR_FALLBACK_URL=https://cdn-nfs.faireconomy.media/ff_calendar_thisweek.json
# FF_CALENDAR_NEXTWEEK_URL=https://nfs.faireconomy.media/ff_calendar_nextweek.json

# ── GDELT (bez klucza) — własne zapytanie dla warstwy ZDARZENIA GEO (opcjonalnie)
# GDELT_GEO_QUERY=(war OR airstrike OR missile OR sanctions OR tariff OR ceasefire) sourcelang:english
# Regiony ryzyka i ich zapytania: src/data/regions.json
# Progi statusu chokepointów (liczba nagłówków o zakłóceniach w 48h)
CHOKE_ELEVATED=1
CHOKE_DISRUPTED=4

# ── AIS (opcjonalnie) — https://aisstream.io (darmowy klucz po zalogowaniu GitHubem)
AISSTREAM_API_KEY=

# ── Alerty Telegram (opcjonalnie): region → HIGH, chokepoint → DISRUPTED, dzień przed decyzją banku spoza USD
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_CB_REMINDER=true
# zmiana znaku bilansu tła makro (przewaga czynników sprzyjających ↔ szkodzących)
ALERT_MACRO_FLIP=true
# poranny skrót „co się zmieniło” (godzina wg czasu warszawskiego)
DIGEST_ENABLED=true
DIGEST_HOUR=8
# Sekret do ręcznego wywołania /api/alerts?run=1 (nagłówek x-alerts-secret)
ALERTS_SECRET=

# ── Redis (opcjonalnie) — trwały cache między restartami
# docker compose --profile redis up -d  →  REDIS_URL=redis://redis:6379
REDIS_URL=
# REDIS_PREFIX=aurum:

# ── Katalog na stan aplikacji (np. „skrót wysłany dziś”), gdy nie ma Redis
DATA_DIR=./.data

# ── Wewnętrzny „cron” (rozgrzewa cache i sprawdza alerty). false = wyłączony
ENABLE_SCHEDULER=true

TZ=Europe/Warsaw
